# Copy to .env and fill in. The CLI loads .env automatically from the current dir.

# --- LLM provider selection -------------------------------------------------
# One of: anthropic | openai | mock
# "mock" returns a deterministic canned response and needs no API key. Useful
# for trying the end-to-end flow offline.
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- GitHub -----------------------------------------------------------------
# Personal access token (classic, "repo" scope) used to read issues and open PRs.
GITHUB_TOKEN=

# --- Agent behaviour --------------------------------------------------------
# Max self-correction loops if the test command fails.
AGENT_MAX_ITERATIONS=3
