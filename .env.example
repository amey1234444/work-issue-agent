# Copy to .env and fill in. The CLI loads .env automatically from the current dir.

# --- LLM provider selection -------------------------------------------------
# One of: anthropic | openai | openrouter | mock
# "mock" returns a deterministic canned response and needs no API key. Useful
# for trying the end-to-end flow offline.
LLM_PROVIDER=anthropic

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# OpenRouter (used when LLM_PROVIDER=openrouter) - OpenAI-compatible gateway to
# hundreds of models. Pick any slug from https://openrouter.ai/models
# (":free" models work on a free-tier key).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- GitHub -----------------------------------------------------------------
# Personal access token (classic, "repo" scope) used to read issues and open PRs.
GITHUB_TOKEN=

# --- Agent behaviour --------------------------------------------------------
# Max self-correction loops if the test command fails.
AGENT_MAX_ITERATIONS=3
