---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
const articles = (await getCollection('docs')).sort((a,b) => a.data.order - b.data.order);
const groups = [...new Set(articles.map(article => article.data.group))];
const icons: Record<string,string> = { 'Start here': 'terminal', 'Build with the agent': 'layers', 'Reference': 'code', 'Operate and extend': 'settings' };
---
<Base title="Documentation — Patchlane" description="Learn Patchlane with a complete user manual, searchable reference, downloadable templates, and an interactive architecture explorer." docs>
  <main id="main" class="docs-home">
    <header class="docs-home-hero"><div><span class="eyebrow">PATCHLANE / DOCUMENTATION</span><h1>From first run<br /><span class="headline-muted">to your workflow.</span></h1><p>Everything you need to install, configure, understand,<br class="desktop-break" /> and build with the agent.</p></div><div class="docs-home-version"><Icon name="book" size={35} /><span>Developer documentation</span><strong>v0.1.0</strong><small>Python 3.10+ · MIT licensed</small></div></header>
    <button class="docs-home-search" data-search-open><Icon name="search" /><span>Search guides, commands, and configuration…</span><kbd>⌘ K</kbd></button>
    <section class="learning-paths" aria-label="Choose a starting point"><a class="learning-card learning-primary" href="/docs/quickstart/"><span class="learning-number">01 / START</span><Icon name="terminal" size={29} /><h2>Run your first task.</h2><p>Install the agent and explore a local mock run before connecting a model.</p><span class="learning-link">Open the quickstart <Icon name="chevron" size={16} /></span></a><a class="learning-card" href="/docs/manual/"><span class="learning-number">02 / LEARN</span><Icon name="book" size={29} /><h2>Know every step.</h2><p>A complete manual from repository setup to reviewing and publishing changes.</p><span class="learning-link">Read the user manual <Icon name="chevron" size={16} /></span></a><a class="learning-card" href="/architecture/"><span class="learning-number">03 / EXPLORE</span><Icon name="layers" size={29} /><h2>Look inside the engine.</h2><p>Play through the control flow and inspect inputs, outputs, retries, and boundaries.</p><span class="learning-link">Explore the architecture <Icon name="chevron" size={16} /></span></a></section>
    <div class="reference-heading"><div><span class="eyebrow">THE COMPLETE REFERENCE</span><h2>Find your next answer.</h2></div><span>{articles.length} guides and references</span></div>
    <div class="docs-directory">{groups.map(group => <section><h2><Icon name={icons[group] || 'book'} size={20} />{group}</h2><div>{articles.filter(article => article.data.group === group).map(article => <a href={`/docs/${article.id}/`}><span><strong>{article.data.title}</strong><p>{article.data.description}</p></span><Icon name="chevron" size={16} /></a>)}</div></section>)}</div>
    <section class="template-banner"><Icon name="file" size={30} /><div><h2>A good run starts with good instructions.</h2><p>Download the workflow, repository instructions, and configuration starters.</p></div><a class="button secondary" href="/docs/manual/#5-add-the-repository-contract">Get the templates</a></section>
  </main>
</Base>
