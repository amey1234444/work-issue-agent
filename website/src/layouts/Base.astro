---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import '../styles/experience.css';
import '../styles/patchlane.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
interface Props { title: string; description?: string; docs?: boolean }
const { title, description = 'A workflow-driven AI coding agent. Turn GitHub issues into code, tests, and pull requests using your repository’s own rules.', docs = false } = Astro.props;
const repo = 'https://github.com/amey1234444/work-issue-agent';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080808" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    {canonical && <><link rel="canonical" href={canonical} /><meta property="og:url" content={canonical} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try { const saved = localStorage.getItem('patchlane-theme') || localStorage.getItem('wia-theme'); document.documentElement.dataset.theme = saved === 'light' ? 'light' : 'dark'; } catch { document.documentElement.dataset.theme = 'dark'; }
      document.querySelector('meta[name="theme-color"]').content = document.documentElement.dataset.theme === 'dark' ? '#080808' : '#ffffff';
    </script>
  </head>
  <body class:list={[docs && 'documentation']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="nav-inner">
        <a class="brand" href="/" aria-label="Patchlane home"><Logo /><span>patchlane<span class="brand-period">.</span></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          <a href="/#how-it-works">Product</a>
          <a href="/docs/" aria-current={docs ? 'page' : undefined}>Docs</a>
          <a href="/docs/manual/">User manual</a>
          <a href="/architecture/" aria-current={Astro.url.pathname.startsWith('/architecture') ? 'page' : undefined}>Architecture</a>
        </nav>
        <div class="nav-actions">
          <button class="search-trigger" data-search-open aria-label="Search documentation"><Icon name="search" size={16} /><span>Search docs</span><kbd>⌘ K</kbd></button>
          <a class="icon-button github-nav" href={repo} aria-label="View on GitHub"><Icon name="github" /></a>
          <button class="icon-button theme-toggle" aria-label="Switch color theme"><Icon name="sun" class="theme-sun" /><Icon name="moon" class="theme-moon" /></button>
          <a class="button small nav-start" href="/docs/quickstart/">Get started</a>
          <button class="icon-button mobile-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><Icon name="menu" /></button>
        </div>
      </div>
      <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden>
        <a href="/#how-it-works">Product</a><a href="/docs/">Documentation</a><a href="/docs/manual/">User manual</a><a href="/architecture/">Architecture explorer</a><a href={repo}>GitHub repository</a><a href="/docs/quickstart/">Get started</a>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="footer-main"><div><a class="brand" href="/"><Logo /><span>patchlane<span class="brand-period">.</span></span></a><p>A clear path from issue to code.<br />Built around the way you work.</p></div>
        <div><h2>Build</h2><a href="/docs/quickstart/">Quickstart</a><a href="/docs/cli/">CLI reference</a><a href="/docs/python-api/">Python API</a></div>
        <div><h2>Learn</h2><a href="/docs/manual/">User manual</a><a href="/architecture/">Architecture explorer</a><a href="/docs/workflows/">Workflows</a><a href="/docs/troubleshooting/">Troubleshooting</a></div>
        <div><h2>Open source</h2><a href={repo}>GitHub</a><a href="/docs/contributing/">Contribute</a><a href={`${repo}/blob/main/LICENSE`}>MIT license</a></div>
      </div>
      <div class="footer-bottom"><span>Built by Amey Bhagwatkar. Open by design.</span><span>Python 3.10+ <span class="footer-divider">/</span> v0.1.0</span></div>
    </footer>
    <dialog class="search-dialog" aria-labelledby="search-title">
      <div class="search-top"><Icon name="search" /><label class="sr-only" for="doc-search" id="search-title">Search documentation</label><input id="doc-search" type="search" placeholder="Search documentation…" autocomplete="off" /><button class="icon-button" data-search-close aria-label="Close search"><Icon name="close" size={18} /></button></div>
      <div class="search-results" aria-live="polite"></div>
      <div class="search-bottom"><span>Search every guide and reference</span><span><kbd>Esc</kbd> to close</span></div>
    </dialog>
    <div id="toast" class="toast" role="status"></div>
    <script>import '../scripts/site';</script>
  </body>
</html>
